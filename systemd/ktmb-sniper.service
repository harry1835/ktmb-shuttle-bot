[Unit]
Description=KTMB Shuttle Tebrau Automated Sniper & Checkout Bot
After=network-online.target ktmb-display.service
Requires=ktmb-display.service

[Service]
Type=simple
WorkingDirectory=/opt/ktmb-shuttle-bot
Environment=DISPLAY=:99
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ktmb-shuttle-bot/.venv/bin/python /opt/ktmb-shuttle-bot/ktmb_sniper.py
Restart=always
RestartSec=3
# Safety net if memory still grows: throttle at MemoryHigh, kill + restart at MemoryMax
# instead of filling the container's swap. Covers Python, the Playwright driver and Chromium.
MemoryHigh=1200M
MemoryMax=1500M
MemorySwapMax=256M

[Install]
WantedBy=multi-user.target

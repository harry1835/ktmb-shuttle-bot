# ============================================================================
# 1. KTMB KITS Account Credentials
# ============================================================================
KTMB_EMAIL=your_email@example.com
KTMB_PASSWORD=your_password

# ============================================================================
# 2. Booking Preferences (2 Tickets Every Weekend)
# ============================================================================
# Total tickets needed per train leg (e.g. 2 for 2 passengers)
PAX_COUNT=2

# Split-booking strategy for sold-out trains:
# Set to false to ONLY buy when >= 2 seats are available together on the SAME train in a single booking!
SPLIT_PAX_SNIPE=false

# Names (or partial names / passport numbers) matching your KITS Favorite Passengers
# Used when SPLIT_PAX_SNIPE=true so Pass #1 books Passenger 1 and Pass #2 books Passenger 2
PASSENGER_1_MATCH=
PASSENGER_2_MATCH=

# Preferred Saturday trains (WOODLANDS CIQ -> JB SENTRAL around 1:00 PM)
SATURDAY_PREFERRED_TIMES=12:30,13:45

# Preferred Sunday trains (JB SENTRAL -> WOODLANDS CIQ around 8:00 PM)
SUNDAY_PREFERRED_TIMES=20:15,19:00,21:30

# ============================================================================
# 3. Target Dates & Polling Settings
# ============================================================================
# Optional fixed dates (format: "D MMM YYYY", e.g. "14 Nov 2026").
# Leave empty to automatically target the upcoming weekend (or --weeks-ahead N).
TARGET_SATURDAY_DATE=
TARGET_SUNDAY_DATE=

# Mode:
#   "auto_weekend" : Automatically snipes Saturday leg then Sunday leg one-way
#   "single_sat"   : Snipes only Saturday (Woodlands -> JB)
#   "single_sun"   : Snipes only Sunday (JB -> Woodlands)
#   "roundtrip"    : Books Sat + Sun together in a single transaction
BOOKING_MODE=auto_weekend

# Pause (seconds) between full calendar sweeps, by time of day (container local time):
#   - PEAK_WINDOW  : around the daily ticket release -> PEAK_POLL_INTERVAL_SECONDS
#   - NIGHT_WINDOW : quiet hours                      -> NIGHT_POLL_INTERVAL_SECONDS
#   - otherwise                                       -> POLL_INTERVAL_SECONDS
POLL_INTERVAL_SECONDS=15
PEAK_WINDOW=08:25-08:45
PEAK_POLL_INTERVAL_SECONDS=2
NIGHT_WINDOW=00:00-07:00
NIGHT_POLL_INTERVAL_SECONDS=60

# Exit between sweeps every N minutes so systemd restarts the bot with fresh memory
# (Chromium grows when left running for days). 0 disables. Never fires around PEAK_WINDOW,
# and only applies when running as the systemd service (manual runs are never stopped).
RECYCLE_MINUTES=60

# ============================================================================
# 4. Checkout & Payment Settings
# ============================================================================
# "KTM_WALLET" for automated checkout, or "MANUAL_ALERT" to hold seat & notify
PAYMENT_METHOD=KTM_WALLET
KTM_WALLET_PIN=

# ============================================================================
# 5. Linux LXC & Telegram Notification Settings
# ============================================================================
# On Linux LXC with Xvfb (`xvfb-run`), keep HEADLESS=false so Chromium runs
# in a virtual X11 display (avoids headless reCAPTCHA & bot detection).
HEADLESS=false

# Optional: NoVNC / VNC URL to include in Telegram alerts when manual verification is needed
VNC_PUBLIC_URL=http://100.108.209.57:6080/vnc.html

# Optional: Groq API Key for FREE automated reCAPTCHA audio challenge solving (Whisper)
GROQ_API_KEY=

# Telegram Bot notifications (highly recommended for LXC container!)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
